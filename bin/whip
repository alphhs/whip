#!/bin/bash
# whip — steer a specific Claude Code session mid-turn, without interrupting it.
#
#   whip                       list sessions (same as `whip ls`)
#   whip attach <target>       bind a session; later whips go there by default
#   whip detach                unbind
#   whip name <label>          name the session you are inside
#   whip name <target> <label> name another session
#   whip "msg"                 whip the attached session (or the one you're in)
#   whip -t <target> "msg"     whip one specific session, just this once
#   whip -a "msg"              whip every live session
#   whip -b "msg"              block that session's NEXT tool call instead
#   whip <preset>              send a named intervention (whip presets)
#   whip presets               list them
#   whip verify "<cmd>"        set this directory's verifier (runs after edits)
#   whip verify off|status     stop it / show it
#   whip verify examples       what is worth checking (and what is not)
#   whip status | clear
#
# <target> is a name, a list number, or the start of a session id.
set -euo pipefail
DIR="$HOME/.claude/whip"; REG="$DIR/reg"; ATT="$DIR/attached"
mkdir -p "$REG" "$DIR/s" "$DIR/b"
NOW=$(date +%s)
PRESETS="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/.." && pwd)/lib/presets.json"
[ -f "$PRESETS" ] || PRESETS="$HOME/.claude/whip/presets.json"

# NOTE: fields are separated by US (0x1f), not tab. Tab counts as IFS
# whitespace, so bash collapses runs of it and an empty field (an unnamed
# session) silently shifts every later field left — which made every entry
# look dead and get pruned.
US=$'\037'
live() {                       # id US name US cwd US seen US pid, newest first
  local f
  for f in "$REG"/*.json; do
    [ -e "$f" ] || continue
    local id name cwd seen pid
    IFS="$US" read -r id name cwd seen pid < <(
      jq -r '[.id,.name,.cwd,(.seen|tostring),(.pid|tostring)]|join("\u001f")' "$f" 2>/dev/null) || continue
    if [ -z "${pid:-}" ] || ! kill -0 "$pid" 2>/dev/null; then rm -f "$f"; continue; fi
    printf '%s%s%s%s%s%s%s%s%s\n' "$id" "$US" "$name" "$US" "$cwd" "$US" "$seen" "$US" "$pid"
  done | sort -t"$US" -k4 -rn
}

resolve() {                    # name | index | id-prefix  ->  id
  local q="$1" i=0 id name cwd seen pid
  while IFS="$US" read -r id name cwd seen pid; do
    i=$((i+1))
    [ "$q" = "$i" ] && { echo "$id"; return; }
    [ -n "$name" ] && [ "$q" = "$name" ] && { echo "$id"; return; }
    case "$id" in "$q"*) echo "$id"; return;; esac
  done < <(live)
}

label() { local id="$1" n c
  IFS="$US" read -r n c < <(jq -r '[.name,.cwd]|join("\u001f")' "$REG/$id.json" 2>/dev/null) || true
  [ -n "${n:-}" ] && echo "$n" || basename "${c:-?}"; }

listing() {
  local att="" i=0 id name cwd seen pid
  [ -f "$ATT" ] && att=$(cat "$ATT")
  while IFS="$US" read -r id name cwd seen pid; do
    i=$((i+1))
    local age=$((NOW-seen)) mark=" " state
    [ "$id" = "$att" ] && mark=">"
    if   [ "$age" -lt 8 ];  then state=$'\033[32m● working\033[0m'
    elif [ "$age" -lt 300 ]; then state="○ idle ${age}s"
    else state="○ idle $((age/60))m"; fi
    sc="$DIR/score/$id.json"
    hunt=""
    [ -f "$sc" ] && hunt="$(jq -r '"  caught \(.caught) / away \(.escapes)"' "$sc" 2>/dev/null)"
    printf '%s %d) %-14s %-22s %b%s  %s\n' "$mark" "$i" \
      "${name:--}" "$(basename "$cwd")" "$state" "$hunt" "${id:0:8}"
  done < <(live)
  [ "$i" -eq 0 ] && echo "  no live Claude Code sessions" && return
  [ -n "$att" ] && echo "  > attached" || echo "  (nothing attached — 'whip attach 1')"
}

case "${1-ls}" in
  ls|list|-l|--list) listing; exit 0 ;;
  attach)
    [ $# -ge 2 ] || { echo "usage: whip attach <name|number|id>"; exit 1; }
    id=$(resolve "$2"); [ -n "$id" ] || { echo "no session matching '$2'"; exit 1; }
    echo "$id" > "$ATT"; echo "attached -> $(label "$id") (${id:0:8})"; exit 0 ;;
  detach) rm -f "$ATT"; echo "detached"; exit 0 ;;
  name)
    if [ $# -eq 2 ]; then
      id="${CLAUDE_CODE_SESSION_ID:-}"; lbl="$2"
      [ -n "$id" ] || { echo "not inside a Claude session — use: whip name <target> <label>"; exit 1; }
    elif [ $# -ge 3 ]; then
      id=$(resolve "$2"); lbl="$3"
      [ -n "$id" ] || { echo "no session matching '$2'"; exit 1; }
    else echo "usage: whip name [<target>] <label>"; exit 1; fi
    [ -f "$REG/$id.json" ] || { echo "session ${id:0:8} is not registered yet (it registers on start, or after its first tool call)"; exit 1; }
    tmp=$(mktemp)
    jq --arg n "$lbl" '.name=$n' "$REG/$id.json" > "$tmp" && mv "$tmp" "$REG/$id.json" \
      || { rm -f "$tmp"; echo "could not write name"; exit 1; }
    echo "named ${id:0:8} -> $lbl"; exit 0 ;;
  verify)
    CFG="$DIR/verify.json"; [ -f "$CFG" ] || echo '{}' > "$CFG"
    root="$PWD"
    case "${2-status}" in
      examples)
        cat <<'EX'
  Weakest to strongest. Pick the strongest one you can actually run.

  style       npx prettier --check .            catches nothing that matters
  types       npx tsc --noEmit                  real, but shallow
  build       npm run build                     catches more
  BOOTS       curl -sf localhost:3000 >/dev/null      <- does it even respond
  RUNS        node scripts/smoke.mjs            <- load the page, fail on console errors
  LOOKS RIGHT node scripts/shot.mjs && compare  <- render it and diff the pixels

  The last three are the ones that catch real bugs. A syntax check passes on an
  app that does not start; this repo's own overlay once passed `node --check`
  with four functions missing and every weapon broken.
EX
        exit 0 ;;
      status)
        jq -r 'to_entries[] | "  \(.key)\n    $ \(.value.cmd)   (max \(.value.max) retries, \(.value.debounce)s debounce)"' "$CFG"
        [ "$(jq 'length' "$CFG")" = "0" ] && echo "  no verifiers set"
        for f in "$DIR"/verify-state/*.json; do [ -e "$f" ] || continue
          printf '  %s: %s consecutive failures%s\n' "$(basename "$f" .json | cut -c1-8)" \
            "$(jq -r '.fails' "$f")" "$([ "$(jq -r '.silenced' "$f")" = true ] && echo ' (silenced)')"; done
        exit 0 ;;
      off)
        tmp=$(mktemp); jq --arg d "$root" 'del(.[$d])' "$CFG" > "$tmp" && mv "$tmp" "$CFG"
        echo "verifier removed for $root"; exit 0 ;;
      *)
        cmd="$2"; max="${3:-3}"
        tmp=$(mktemp)
        jq --arg d "$root" --arg c "$cmd" --argjson m "$max" \
          '.[$d]={cmd:$c, max:$m, debounce:20}' "$CFG" > "$tmp" && mv "$tmp" "$CFG"
        # Karpathy's AutoResearch split: the agent edits train.py, never
        # prepare.py. An agent that can edit its own verifier will eventually
        # lower the bar instead of clearing it — so deny it the file and the
        # command. Permission rules gate the agent's tool calls, not your shell,
        # so you can still run `whip verify off` yourself.
        S="$HOME/.claude/settings.json"; [ -f "$S" ] || echo '{}' > "$S"
        tmp2=$(mktemp)
        jq --arg f "Edit($CFG)" --arg b "Bash(whip verify:*)" \
           '.permissions.deny = ((.permissions.deny // []) + [$f,$b] | unique)' "$S" > "$tmp2" \
           && mv "$tmp2" "$S"
        echo "verifier for $root:"; echo "  \$ $cmd"
        echo "  runs after Write/Edit, 20s debounce, gives up after $max consecutive failures"
        echo "  agents are now denied edit access to it, and denied 'whip verify'"
        exit 0 ;;
    esac ;;
  presets)
    jq -r 'to_entries[] | "  \(.key|.+"            "|.[0:11])  \(.value.label)"' "$PRESETS"
    echo; echo "  whip cause          # or any of the above"
    exit 0 ;;
  status)
    [ -f "$ATT" ] && echo "attached: $(label "$(cat "$ATT")")" || echo "attached: (none)"
    n=0; for f in "$DIR"/s/* "$DIR"/b/*; do [ -e "$f" ] || continue
      n=$((n+1)); printf '  pending %-6s %-12s %s\n' "$(basename "$(dirname "$f")")" \
        "$(label "$(basename "$f")" 2>/dev/null || echo '?')" "$(cat "$f")"; done
    [ "$n" -eq 0 ] && echo "  nothing pending"; exit 0 ;;
  clear|-c|--clear) rm -f "$DIR"/s/* "$DIR"/b/* 2>/dev/null || true; echo "cleared"; exit 0 ;;
  -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

MODE=s; TARGET=""; ALL=0
while [ $# -gt 0 ]; do
  case "$1" in
    -b|--block)  MODE=b; shift ;;
    -a|--all)    ALL=1; shift ;;
    -t|--target) TARGET="$2"; shift 2 ;;
    *) break ;;
  esac
done

MSG="${*:-}"
KIND="user"; LABEL=""
if [ $# -eq 1 ] && [ -f "$PRESETS" ] && jq -e --arg k "$1" 'has($k)' "$PRESETS" >/dev/null 2>&1; then
  LABEL=$(jq -r --arg k "$1" '.[$k].label' "$PRESETS")
  MSG=$(jq -r --arg k "$1" '.[$k].text'  "$PRESETS")
  KIND="preset"
fi
[ -n "$MSG" ] || { echo "nothing to send (whip presets)"; exit 1; }

ids=()
if [ "$ALL" = 1 ]; then
  while IFS="$US" read -r id _ _ _ _; do ids+=("$id"); done < <(live)
elif [ -n "$TARGET" ]; then
  id=$(resolve "$TARGET"); [ -n "$id" ] || { echo "no session matching '$TARGET' (whip ls)"; exit 1; }
  ids+=("$id")
elif [ -f "$ATT" ] && [ -s "$ATT" ] && [ -f "$REG/$(cat "$ATT").json" ]; then
  ids+=("$(cat "$ATT")")                       # you attached; that is the default
elif [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
  ids+=("$CLAUDE_CODE_SESSION_ID")             # running inside a session: itself
else
  first=$(live | head -1 | cut -d"$US" -f1)
  [ -n "$first" ] || { echo "no live Claude Code sessions"; exit 1; }
  ids+=("$first")
fi

for id in "${ids[@]}"; do
  [ -n "$id" ] || continue
  jq -n --arg t "$MSG" --arg s "$KIND" --arg l "$LABEL" \
     '{text:$t, src:$s} + (if $l=="" then {} else {preset:$l} end)' > "$DIR/$MODE/$id"
  printf '%s -> %s: %s\n' "$([ "$MODE" = b ] && echo 'BLOCK' || echo 'whip')" \
    "$(label "$id")" "${LABEL:-$MSG}"
done
