#!/bin/bash
# whip — steer a specific Claude Code session mid-turn, without interrupting it.
#
#   whip                       list sessions (same as `whip ls`)
#   whip attach <target>       bind a session; later whips go there by default
#   whip detach                unbind
#   whip name <label>          name the session you are inside
#   whip name <target> <label> name another session
#   whip "msg"                 whip the attached session (or the one you're in)
#   whip -t <target> "msg"     whip one specific session, just this once
#   whip -a "msg"              whip every live session
#   whip -b "msg"              block that session's NEXT tool call instead
#   whip status | clear
#
# <target> is a name, a list number, or the start of a session id.
set -euo pipefail
DIR="$HOME/.claude/whip"; REG="$DIR/reg"; ATT="$DIR/attached"
mkdir -p "$REG" "$DIR/s" "$DIR/b"
NOW=$(date +%s)

# NOTE: fields are separated by US (0x1f), not tab. Tab counts as IFS
# whitespace, so bash collapses runs of it and an empty field (an unnamed
# session) silently shifts every later field left — which made every entry
# look dead and get pruned.
US=$'\037'
live() {                       # id US name US cwd US seen US pid, newest first
  local f
  for f in "$REG"/*.json; do
    [ -e "$f" ] || continue
    local id name cwd seen pid
    IFS="$US" read -r id name cwd seen pid < <(
      jq -r '[.id,.name,.cwd,(.seen|tostring),(.pid|tostring)]|join("\u001f")' "$f" 2>/dev/null) || continue
    if [ -z "${pid:-}" ] || ! kill -0 "$pid" 2>/dev/null; then rm -f "$f"; continue; fi
    printf '%s%s%s%s%s%s%s%s%s\n' "$id" "$US" "$name" "$US" "$cwd" "$US" "$seen" "$US" "$pid"
  done | sort -t"$US" -k4 -rn
}

resolve() {                    # name | index | id-prefix  ->  id
  local q="$1" i=0 id name cwd seen pid
  while IFS="$US" read -r id name cwd seen pid; do
    i=$((i+1))
    [ "$q" = "$i" ] && { echo "$id"; return; }
    [ -n "$name" ] && [ "$q" = "$name" ] && { echo "$id"; return; }
    case "$id" in "$q"*) echo "$id"; return;; esac
  done < <(live)
}

label() { local id="$1" n c
  IFS="$US" read -r n c < <(jq -r '[.name,.cwd]|join("\u001f")' "$REG/$id.json" 2>/dev/null) || true
  [ -n "${n:-}" ] && echo "$n" || basename "${c:-?}"; }

listing() {
  local att="" i=0 id name cwd seen pid
  [ -f "$ATT" ] && att=$(cat "$ATT")
  while IFS="$US" read -r id name cwd seen pid; do
    i=$((i+1))
    local age=$((NOW-seen)) mark=" " state
    [ "$id" = "$att" ] && mark=">"
    if   [ "$age" -lt 8 ];  then state=$'\033[32m● working\033[0m'
    elif [ "$age" -lt 300 ]; then state="○ idle ${age}s"
    else state="○ idle $((age/60))m"; fi
    printf '%s %d) %-14s %-26s %b  %s\n' "$mark" "$i" \
      "${name:--}" "$(basename "$cwd")" "$state" "${id:0:8}"
  done < <(live)
  [ "$i" -eq 0 ] && echo "  no live Claude Code sessions" && return
  [ -n "$att" ] && echo "  > attached" || echo "  (nothing attached — 'whip attach 1')"
}

case "${1-ls}" in
  ls|list|-l|--list) listing; exit 0 ;;
  attach)
    [ $# -ge 2 ] || { echo "usage: whip attach <name|number|id>"; exit 1; }
    id=$(resolve "$2"); [ -n "$id" ] || { echo "no session matching '$2'"; exit 1; }
    echo "$id" > "$ATT"; echo "attached -> $(label "$id") (${id:0:8})"; exit 0 ;;
  detach) rm -f "$ATT"; echo "detached"; exit 0 ;;
  name)
    if [ $# -eq 2 ]; then
      id="${CLAUDE_CODE_SESSION_ID:-}"; lbl="$2"
      [ -n "$id" ] || { echo "not inside a Claude session — use: whip name <target> <label>"; exit 1; }
    elif [ $# -ge 3 ]; then
      id=$(resolve "$2"); lbl="$3"
      [ -n "$id" ] || { echo "no session matching '$2'"; exit 1; }
    else echo "usage: whip name [<target>] <label>"; exit 1; fi
    [ -f "$REG/$id.json" ] || { echo "session ${id:0:8} is not registered yet (it registers on start, or after its first tool call)"; exit 1; }
    tmp=$(mktemp)
    jq --arg n "$lbl" '.name=$n' "$REG/$id.json" > "$tmp" && mv "$tmp" "$REG/$id.json" \
      || { rm -f "$tmp"; echo "could not write name"; exit 1; }
    echo "named ${id:0:8} -> $lbl"; exit 0 ;;
  status)
    [ -f "$ATT" ] && echo "attached: $(label "$(cat "$ATT")")" || echo "attached: (none)"
    n=0; for f in "$DIR"/s/* "$DIR"/b/*; do [ -e "$f" ] || continue
      n=$((n+1)); printf '  pending %-6s %-12s %s\n' "$(basename "$(dirname "$f")")" \
        "$(label "$(basename "$f")" 2>/dev/null || echo '?')" "$(cat "$f")"; done
    [ "$n" -eq 0 ] && echo "  nothing pending"; exit 0 ;;
  clear|-c|--clear) rm -f "$DIR"/s/* "$DIR"/b/* 2>/dev/null || true; echo "cleared"; exit 0 ;;
  -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

MODE=s; TARGET=""; ALL=0
while [ $# -gt 0 ]; do
  case "$1" in
    -b|--block)  MODE=b; shift ;;
    -a|--all)    ALL=1; shift ;;
    -t|--target) TARGET="$2"; shift 2 ;;
    *) break ;;
  esac
done

MSG="${*:-}"
[ -n "$MSG" ] || MSG="FASTER"

ids=()
if [ "$ALL" = 1 ]; then
  while IFS="$US" read -r id _ _ _ _; do ids+=("$id"); done < <(live)
elif [ -n "$TARGET" ]; then
  id=$(resolve "$TARGET"); [ -n "$id" ] || { echo "no session matching '$TARGET' (whip ls)"; exit 1; }
  ids+=("$id")
elif [ -f "$ATT" ] && [ -s "$ATT" ] && [ -f "$REG/$(cat "$ATT").json" ]; then
  ids+=("$(cat "$ATT")")                       # you attached; that is the default
elif [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
  ids+=("$CLAUDE_CODE_SESSION_ID")             # running inside a session: itself
else
  first=$(live | head -1 | cut -d"$US" -f1)
  [ -n "$first" ] || { echo "no live Claude Code sessions"; exit 1; }
  ids+=("$first")
fi

for id in "${ids[@]}"; do
  [ -n "$id" ] || continue
  printf '%s' "$MSG" > "$DIR/$MODE/$id"
  printf '%s -> %s: %s\n' "$([ "$MODE" = b ] && echo 'BLOCK' || echo 'whip')" "$(label "$id")" "$MSG"
done
